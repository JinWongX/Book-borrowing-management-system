# 后端环境变量配置示例
# 复制本文件为 backend/.env 并填入真实值后再启动服务。

# 【必填】JWT 签名密钥，生产环境必须设置为强随机字符串（>= 256 bit）
# 未设置时系统会随机生成一个临时密钥，并在每次重启后变化。
SECRET_KEY=

# 调试模式：True 开启调试/自动文档/SQL 回显；False 关闭（生产环境必须 False）
DEBUG=False

# 数据库连接地址
DATABASE_URL=sqlite:///./database.sqlite

# CORS 允许的前端来源，逗号分隔；生产环境仅保留实际前端 HTTPS 域名
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# 种子账号初始密码。生产环境首次初始化前必须设置为强密码，
# 未设置时系统会生成随机密码并打印在控制台。
INITIAL_PASSWORD_EMPLOYEE=
INITIAL_PASSWORD_LIBRARIAN=
INITIAL_PASSWORD_ADMIN=
